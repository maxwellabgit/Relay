{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RELAY",
  "version": "0.1.0",
  "identifier": "app.relay.desktop",
  "build": {
    "beforeDevCommand": "npm run start --workspace @relay/app -- --port 8081",
    "devUrl": "http://localhost:8081",
    "beforeBuildCommand": "npm run export:web --workspace @relay/app",
    "frontendDist": "../../relay/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "RELAY",
        "width": 1280,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../tools/audio": "tools/audio"
    }
  },
  "plugins": {}
}
