<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Authored evaluation cases (the unseen and failure sets); recorded cases are derived from task diagnostics at run time. -->
    <Content Include="Evaluation\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The model-primary set: delegation cases only a model planner can pass; scored by the live run, not by the grammar. -->
    <Content Include="Evaluation\model\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The mind set (docs/09): cases scored on the loop's moves — the world clock build, local-first answers, delegation as a package. -->
    <Content Include="Evaluation\mind\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Alpha observing stage: one pass against a recorded window, scored on what was raised. -->
    <Content Include="Evaluation\observing\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Relay.Core\Relay.Core.csproj" />
    <!-- The worker is referenced so its protocol code runs in-process in scenario tests and its built
         executable is available beside the test assembly for the real-process tests. -->
    <ProjectReference Include="..\..\src\Relay.Worker\Relay.Worker.csproj" />
    <ProjectReference Include="..\..\src\Relay.Gateway\Relay.Gateway.csproj" />
    <!-- Windows-only pieces (DPAPI secrets, job-object sandbox) are tested for real; the product is Windows-only. -->
    <ProjectReference Include="..\..\src\Relay.Windows\Relay.Windows.csproj" />
  </ItemGroup>

</Project>
