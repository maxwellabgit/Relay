{
  "name": "relay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "adapters/*",
    "tools/*"
  ],
  "scripts": {
    "dev:web": "node tools/with-demo-flag.mjs npm run start --workspace @relay/app",
    "dev:desktop": "npm run tauri:dev --workspace @relay/desktop",
    "build:web": "npm run export:web --workspace @relay/app",
    "build:desktop": "npm run tauri:build --workspace @relay/desktop",
    "demo:web": "node tools/with-demo-flag.mjs npm run start --workspace @relay/app",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run test:architecture",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:replay": "vitest run --project replay",
    "test:privacy": "vitest run --project privacy",
    "test:architecture": "vitest run --project architecture",
    "test:smoke": "vitest run --project integration adapters/node/src/production-smoke.integration.test.ts",
    "test:manual:msrp": "tsx tools/manual/msrp-preflight.ts",
    "test:e2e:msrp": "tsx tools/e2e/msrp-desktop-headed.ts",
    "test:e2e:windows": "tsx tools/e2e/run-windows.ts",
    "test:e2e:golden": "node tools/e2e/golden-journeys.mjs",
    "test:soak": "tsx tools/e2e/soak.ts",
    "test:nsis:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File ./dev/nsis-install-smoke.ps1",
    "verify:v1": "node tools/verify-v1.mjs",
    "readiness:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ./dev/windows-v1-readiness.ps1",
    "readiness:dogfood": "powershell -NoProfile -ExecutionPolicy Bypass -File ./dev/windows-v1-dogfood-readiness.ps1",
    "audio:prepare": "npm run prepare:audio --workspace @relay/audio-tools",
    "halo:emulator": "python -m relay_halo.bridge --emulator",
    "halo:test": "python -m pytest tools/halo/tests -q",
    "replay": "tsx tools/replay/src/cli.ts replay",
    "logs:tail": "tsx tools/replay/src/cli.ts logs:tail",
    "replay:last": "tsx tools/replay/src/cli.ts replay:last",
    "eval:thresholds": "tsx tools/replay/src/cli.ts eval:thresholds",
    "diagnose:latest": "tsx tools/diagnose/cli.ts diagnose:latest",
    "diagnose:case": "tsx tools/diagnose/cli.ts diagnose:case",
    "logs:follow": "tsx tools/diagnose/cli.ts logs:follow",
    "e2e:last": "tsx tools/diagnose/cli.ts e2e:last",
    "compare:runs": "tsx tools/diagnose/cli.ts compare:runs"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.1",
    "eslint": "^9.35.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "playwright-core": "^1.55.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  }
}
