{
  "manifest_version": 3,
  "name": "RELAY",
  "version": "0.1.0",
  "description": "Sends permitted browsing activity to RELAY on this computer.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["sidePanel", "nativeMessaging", "storage", "scripting", "activeTab"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "RELAY"
  }
}
