<Window
    x:Class="Relay.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Relay.Desktop"
    Title="Relay">

    <Grid x:Name="RootGrid" PreviewKeyDown="RootGrid_PreviewKeyDown">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="18,14" />
            </Style>
            <Style x:Key="RegionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="140" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <Style x:Key="Secondary" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Mono" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <Style x:Key="Chip" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="999" />
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ChipText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="SmallButton" TargetType="Button">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="MinHeight" Value="0" />
            </Style>
            <Style x:Key="DrawerTab" TargetType="ToggleButton">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" Padding="18,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="RELAY" FontWeight="SemiBold" FontSize="13" CharacterSpacing="220" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleSubtitle" Grid.Column="1" Style="{StaticResource Mono}" VerticalAlignment="Center" Text="local-first orchestrator" />
        </Grid>

        <!-- Startup failure -->
        <Border x:Name="StartupFailurePanel" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed" Style="{StaticResource Card}" Margin="16" VerticalAlignment="Top">
            <StackPanel Spacing="8">
                <TextBlock Text="RELAY COULD NOT START" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                <TextBlock x:Name="StartupFailureText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                <TextBlock x:Name="StartupFailureHint" Style="{StaticResource Secondary}" />
            </StackPanel>
        </Border>

        <!-- Status line -->
        <Border x:Name="StatusLine" Grid.Row="1" Padding="18,8,18,10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Ellipse x:Name="StateDot" Width="8" Height="8" VerticalAlignment="Center" Fill="Gray" />
                        <TextBlock x:Name="StateLabel" Text="STARTING" FontSize="14" FontWeight="SemiBold" CharacterSpacing="40" VerticalAlignment="Center" />
                        <TextBlock x:Name="ModeLabel" Style="{StaticResource Secondary}" VerticalAlignment="Center" FontSize="12" />
                        <TextBlock x:Name="StateDetail" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="360" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="SettingsButton" Style="{StaticResource SmallButton}" Content="Settings" Click="Settings_Click" />
                    </StackPanel>
                </Grid>
                <local:WrapPanel HorizontalSpacing="6" VerticalSpacing="6">
                    <Border Style="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="NoteKeyDot" Width="6" Height="6" Fill="Gray" VerticalAlignment="Center" />
                            <TextBlock x:Name="NoteKeyChip" Style="{StaticResource ChipText}" Text="LISTEN" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="CommandKeyDot" Width="6" Height="6" Fill="Gray" VerticalAlignment="Center" />
                            <TextBlock x:Name="CommandKeyChip" Style="{StaticResource ChipText}" Text="ASK" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Chip}">
                        <TextBlock x:Name="ScopeChip" Style="{StaticResource ChipText}" Text="this window only" />
                    </Border>
                    <Border Style="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="OrchestratorDot" Width="6" Height="6" Fill="Gray" VerticalAlignment="Center" />
                            <TextBlock x:Name="OrchestratorChip" Style="{StaticResource ChipText}" Text="Mind" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="ListeningDot" Width="6" Height="6" Fill="Gray" VerticalAlignment="Center" />
                            <TextBlock x:Name="ListeningChip" Style="{StaticResource ChipText}" Text="Listening" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="LedgerDot" Width="6" Height="6" Fill="Gray" VerticalAlignment="Center" />
                            <TextBlock x:Name="LedgerChip" Style="{StaticResource ChipText}" Text="Ledger" />
                        </StackPanel>
                    </Border>
                </local:WrapPanel>
                <StackPanel x:Name="ProcessPanel" Spacing="4" Visibility="Collapsed">
                    <local:WrapPanel x:Name="ProcessTags" HorizontalSpacing="6" VerticalSpacing="6" />
                </StackPanel>
                <local:WrapPanel HorizontalSpacing="4" VerticalSpacing="4">
                    <ToggleButton x:Name="ProjectsDrawerTab" Style="{StaticResource DrawerTab}" Content="Projects" Click="DrawerTab_Click" Tag="projects" />
                    <ToggleButton x:Name="ReviewDrawerTab" Style="{StaticResource DrawerTab}" Content="Review" Click="DrawerTab_Click" Tag="review" />
                    <ToggleButton x:Name="TasksDrawerTab" Style="{StaticResource DrawerTab}" Content="Tasks" Click="DrawerTab_Click" Tag="tasks" />
                    <ToggleButton x:Name="InboxDrawerTab" Style="{StaticResource DrawerTab}" Content="Inbox" Click="DrawerTab_Click" Tag="inbox" />
                    <ToggleButton x:Name="LedgerDrawerTab" Style="{StaticResource DrawerTab}" Content="Ledger" Click="DrawerTab_Click" Tag="ledger" />
                    <ToggleButton x:Name="PrefsDrawerTab" Style="{StaticResource DrawerTab}" Content="Preferences" Click="DrawerTab_Click" Tag="prefs" />
                    <ToggleButton x:Name="DiagnosticsDrawerTab" Style="{StaticResource DrawerTab}" Content="Diagnostics" Click="DrawerTab_Click" Tag="diagnostics" />
                </local:WrapPanel>
            </StackPanel>
        </Border>

        <!-- Main work surface: feed + optional drawer -->
        <Grid x:Name="MainSurface" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="DrawerColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Feed -->
            <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" Padding="18,12,18,8">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="FeedEmpty" Style="{StaticResource Secondary}"
                               Text="Nothing yet. Ask below, or press the listen / instruction chords. The mind’s sentences land here." />
                    <StackPanel x:Name="FeedItems" Spacing="10" />
                </StackPanel>
            </ScrollViewer>

            <!-- Side drawer -->
            <Border x:Name="DrawerHost" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="14,12,10,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DrawerTitle" Text="DRAWER" Style="{StaticResource RegionHeader}" VerticalAlignment="Center" />
                        <TextBlock x:Name="DrawerMeta" Style="{StaticResource Mono}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="Close" Click="CloseDrawer_Click" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,0,14,14">
                        <Grid>
                            <!-- Projects -->
                            <StackPanel x:Name="ProjectsDrawer" Spacing="10" Visibility="Collapsed">
                                <TextBlock x:Name="ProjectsEmpty" Style="{StaticResource Secondary}" Text="No projects yet. Use New project… to pick the folder projects live in; after that “create project &lt;name&gt;” works by voice too." />
                                <StackPanel x:Name="ProjectItems" Spacing="6" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="NewProjectButton" Style="{StaticResource SmallButton}" Content="New project…" Click="NewProject_Click" />
                                    <Button x:Name="BackupButton" Style="{StaticResource SmallButton}" Content="Export backup" Click="Backup_Click" />
                                </StackPanel>
                            </StackPanel>
                            <!-- Review -->
                            <StackPanel x:Name="ReviewDrawer" Spacing="10" Visibility="Collapsed">
                                <TextBlock x:Name="ReviewEmpty" Style="{StaticResource Secondary}" Text="Nothing awaiting your decision." />
                                <StackPanel x:Name="ReviewItems" Spacing="8" />
                            </StackPanel>
                            <!-- Tasks -->
                            <StackPanel x:Name="TasksDrawer" Spacing="10" Visibility="Collapsed">
                                <TextBlock x:Name="TasksEmpty" Style="{StaticResource Secondary}" Text="No tasks yet. Direct asks, observed findings and follow-ups all appear here with the lane they run in." />
                                <StackPanel x:Name="TaskItems" Spacing="6" />
                            </StackPanel>
                            <!-- Inbox -->
                            <StackPanel x:Name="InboxDrawer" Spacing="10" Visibility="Collapsed">
                                <TextBlock x:Name="InboxEmpty" Style="{StaticResource Secondary}" Text="No unrouted notes. Notes that mention a project are filed there automatically; the rest wait here." />
                                <StackPanel x:Name="InboxItems" Spacing="8" />
                            </StackPanel>
                            <!-- Ledger / Activity -->
                            <StackPanel x:Name="LedgerDrawer" Spacing="8" Visibility="Collapsed">
                                <TextBlock x:Name="ActivityCount" Style="{StaticResource Mono}" />
                                <ListView x:Name="ActivityList" Height="420" SelectionMode="None" IsItemClickEnabled="False"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="0" Margin="-12,0"
                                          Loaded="ActivityList_Loaded">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="Padding" Value="12,3" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:ActivityRow">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Time}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Text}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Type}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                            <!-- Preferences / change sets -->
                            <StackPanel x:Name="PrefsDrawer" Spacing="10" Visibility="Collapsed">
                                <TextBlock x:Name="PreferencesText" Style="{StaticResource Secondary}" IsTextSelectionEnabled="True" />
                                <StackPanel x:Name="PinnedPanel" Spacing="6" Visibility="Collapsed">
                                    <TextBlock Text="ALWAYS SHOWN" Style="{StaticResource RegionHeader}" />
                                    <local:WrapPanel x:Name="PinnedTerms" HorizontalSpacing="6" VerticalSpacing="6" />
                                </StackPanel>
                                <StackPanel x:Name="GrantsPanel" Spacing="6" Visibility="Collapsed">
                                    <TextBlock Text="STANDING GRANTS" Style="{StaticResource RegionHeader}" />
                                    <StackPanel x:Name="GrantItems" Spacing="4" />
                                </StackPanel>
                                <StackPanel x:Name="ChangeSetsPanel" Spacing="6" Visibility="Collapsed">
                                    <TextBlock Text="CHANGE SETS" Style="{StaticResource RegionHeader}" />
                                    <StackPanel x:Name="ChangeSetItems" Spacing="4" />
                                </StackPanel>
                                <TextBlock x:Name="RelayHint" Style="{StaticResource Secondary}" FontSize="11" Text="Shape Relay by asking: “keep responses concise”, “always show what CAD means”, “file Atlas decisions without asking”. Each is a change set you approve and can revert here." />
                            </StackPanel>
                            <!-- Diagnostics -->
                            <StackPanel x:Name="DiagnosticsDrawer" Spacing="12" Visibility="Collapsed">
                                <StackPanel x:Name="TaskDiagnosticsPanel" Spacing="8" Visibility="Collapsed">
                                    <Grid>
                                        <TextBlock x:Name="TaskDiagnosticsTitle" Text="TASK" Style="{StaticResource RegionHeader}" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                            <Button x:Name="OpenTaskFileButton" Style="{StaticResource SmallButton}" Content="Open record" Click="OpenTaskFile_Click" />
                                            <Button Style="{StaticResource SmallButton}" Content="Close" Click="CloseTaskDiagnostics_Click" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid x:Name="TaskDiagnosticsGrid" ColumnSpacing="16" RowSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                </StackPanel>
                                <TextBlock Text="SYSTEM" Style="{StaticResource RegionHeader}" />
                                <Grid x:Name="DiagnosticsGrid" ColumnSpacing="16" RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Composer -->
        <Border x:Name="Composer" Grid.Row="3" Padding="18,10,18,16" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <StackPanel Spacing="8">
                <InfoBar x:Name="FocusBar" Severity="Warning" IsOpen="False" IsClosable="False"
                         Title="Capture surface lost focus"
                         Message="Text inserted by Flow will go to whichever window is focused, not to Relay.">
                    <InfoBar.ActionButton>
                        <Button Content="Refocus" Click="Refocus_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <StackPanel x:Name="ListeningPanel" Spacing="6" Visibility="Collapsed">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="BufferBar" Minimum="0" Maximum="90" Value="0" VerticalAlignment="Center" />
                        <TextBlock x:Name="BufferText" Grid.Column="1" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="ListeningText" Style="{StaticResource Secondary}" />
                    <TextBlock x:Name="ListeningError" Style="{StaticResource Secondary}" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
                </StackPanel>
                <TextBlock x:Name="ReadyGreeting" Text="Ready" FontSize="16" FontWeight="SemiBold" Visibility="Collapsed" />
                <TextBox x:Name="CaptureBox"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="180"
                         FontSize="15" IsReadOnly="True" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                         BorderThickness="0" CornerRadius="8" Padding="14,10"
                         Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PlaceholderText="Press Ctrl+Alt to listen or Ctrl+X to give an instruction."
                         TextChanged="CaptureBox_TextChanged" GotFocus="CaptureBox_GotFocus" LostFocus="CaptureBox_LostFocus" KeyDown="CaptureBox_KeyDown"
                         Visibility="Collapsed" />
                <TextBlock x:Name="CaptureMeta" Style="{StaticResource Mono}" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CancelButton" Content="Cancel  (Esc)" Click="Cancel_Click" Visibility="Collapsed" />
                    <Button x:Name="SubmitNowButton" Content="Submit now" Click="SubmitNow_Click" Visibility="Collapsed" Style="{ThemeResource AccentButtonStyle}" />
                    <Button x:Name="RetryWaitButton" Content="Retry wait" Click="RetryWait_Click" Visibility="Collapsed" />
                    <Button x:Name="DismissButton" Content="Return to Idle" Click="Dismiss_Click" Visibility="Collapsed" />
                    <Button x:Name="RetryButton" Content="Retry" Click="Retry_Click" Visibility="Collapsed" Style="{ThemeResource AccentButtonStyle}" />
                    <Button x:Name="UnlockButton" Content="Unlock" Click="Unlock_Click" Visibility="Collapsed" Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>
                <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
                <Grid x:Name="AskPanel" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AskBox" AutomationProperties.Name="Ask box" PlaceholderText="Ask Relay… (Enter)" FontSize="14" IsSpellCheckEnabled="False"
                             BorderThickness="0" CornerRadius="8" Padding="14,10"
                             Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                             KeyDown="AskBox_KeyDown" />
                    <Button x:Name="AskButton" Grid.Column="1" Content="Ask" Click="Ask_Click" VerticalAlignment="Center" Style="{ThemeResource AccentButtonStyle}" />
                </Grid>
                <TextBlock x:Name="AskHint" Style="{StaticResource Secondary}" FontSize="11" Text="Instructions and answers go here. Note capture and listening still use the chords." />
            </StackPanel>
        </Border>
    </Grid>
</Window>
