<Window
    x:Class="Relay.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Relay.Desktop"
    Title="Relay">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,12" />
            </Style>
            <Style x:Key="RegionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="60" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="Secondary" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Mono" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <Style x:Key="Chip" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="8,3" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" Padding="16,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Relay" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleSubtitle" Grid.Column="1" Style="{StaticResource Secondary}" VerticalAlignment="Center" Text="local-first orchestrator · v0.1 foundation" />
        </Grid>

        <!-- Startup failure (replaces everything when the runtime could not be created) -->
        <Border x:Name="StartupFailurePanel" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource Card}" Margin="16" VerticalAlignment="Top">
            <StackPanel Spacing="8">
                <TextBlock Text="RELAY COULD NOT START" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                <TextBlock x:Name="StartupFailureText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                <TextBlock x:Name="StartupFailureHint" Style="{StaticResource Secondary}" />
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,0,16,16">
            <StackPanel Spacing="12">

                <!-- 1. STATUS -->
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse x:Name="StateDot" Width="12" Height="12" VerticalAlignment="Center" Fill="Gray" />
                                <TextBlock x:Name="StateLabel" Text="STARTING" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="ModeLabel" Style="{StaticResource Secondary}" VerticalAlignment="Center" FontSize="14" />
                            </StackPanel>
                            <TextBlock x:Name="StateDetail" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Style="{StaticResource Chip}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse x:Name="NoteKeyDot" Width="7" Height="7" Fill="Gray" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NoteKeyChip" FontSize="12" Text="F13 NOTE" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Chip}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse x:Name="CommandKeyDot" Width="7" Height="7" Fill="Gray" VerticalAlignment="Center" />
                                        <TextBlock x:Name="CommandKeyChip" FontSize="12" Text="F14 COMMAND" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                <Border Style="{StaticResource Chip}">
                                    <TextBlock x:Name="RelayChip" FontSize="12" Text="Flow relay off" />
                                </Border>
                                <Border Style="{StaticResource Chip}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse x:Name="LedgerDot" Width="7" Height="7" Fill="Gray" VerticalAlignment="Center" />
                                        <TextBlock x:Name="LedgerChip" FontSize="12" Text="Ledger" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. CAPTURE / RESPONSE -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="CAPTURE" Style="{StaticResource RegionHeader}" VerticalAlignment="Center" />
                            <TextBlock x:Name="CaptureMeta" Style="{StaticResource Mono}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="ReadyGreeting" Text="Ready" FontSize="20" FontWeight="SemiBold" Visibility="Collapsed" />
                        <InfoBar x:Name="FocusBar" Severity="Warning" IsOpen="False" IsClosable="False"
                                 Title="Capture surface lost focus"
                                 Message="Text inserted by Flow will go to whichever window is focused, not to Relay.">
                            <InfoBar.ActionButton>
                                <Button Content="Refocus" Click="Refocus_Click" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <TextBox x:Name="CaptureBox"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="170" MaxHeight="360"
                                 FontSize="15" IsReadOnly="True" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 PlaceholderText="Press F13 to start a silent note or F14 to give an instruction."
                                 TextChanged="CaptureBox_TextChanged" GotFocus="CaptureBox_GotFocus" LostFocus="CaptureBox_LostFocus" KeyDown="CaptureBox_KeyDown" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CancelButton" Content="Cancel  (Esc)" Click="Cancel_Click" Visibility="Collapsed" />
                            <Button x:Name="SubmitNowButton" Content="Submit now" Click="SubmitNow_Click" Visibility="Collapsed" Style="{ThemeResource AccentButtonStyle}" />
                            <Button x:Name="RetryWaitButton" Content="Retry wait" Click="RetryWait_Click" Visibility="Collapsed" />
                            <Button x:Name="DismissButton" Content="Return to Idle" Click="Dismiss_Click" Visibility="Collapsed" />
                            <Button x:Name="RetryButton" Content="Retry" Click="Retry_Click" Visibility="Collapsed" Style="{ThemeResource AccentButtonStyle}" />
                            <Button x:Name="UnlockButton" Content="Unlock" Click="Unlock_Click" Visibility="Collapsed" Style="{ThemeResource AccentButtonStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
                        <TextBlock x:Name="ReceiptText" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- 3. REVIEW -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="REVIEW" Style="{StaticResource RegionHeader}" />
                            <TextBlock x:Name="ReviewCount" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock x:Name="ReviewEmpty" Style="{StaticResource Secondary}" Text="Nothing awaiting your decision." />
                        <StackPanel x:Name="ReviewItems" Spacing="8" />
                    </StackPanel>
                </Border>

                <!-- 4. ACTIVITY -->
                <Border Style="{StaticResource Card}" Padding="16,12,16,8">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="ACTIVITY" Style="{StaticResource RegionHeader}" />
                            <TextBlock x:Name="ActivityCount" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                        </Grid>
                        <ListView x:Name="ActivityList" Height="220" SelectionMode="None" IsItemClickEnabled="False"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="0" Margin="-12,0"
                                  Loaded="ActivityList_Loaded">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="12,3" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:ActivityRow">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Time}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Text}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Type}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- DIAGNOSTICS -->
                <Expander x:Name="DiagnosticsExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Expanding="Diagnostics_Expanding">
                    <Expander.Header>
                        <TextBlock Text="DIAGNOSTICS" Style="{StaticResource RegionHeader}" />
                    </Expander.Header>
                    <Grid x:Name="DiagnosticsGrid" ColumnSpacing="16" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
