<Window
    x:Class="Relay.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Relay.Desktop"
    Title="Relay">

    <Grid x:Name="RootGrid" PreviewKeyDown="RootGrid_PreviewKeyDown">
        <Grid.Resources>
            <!-- Flat cards on the dark Mica surface: a translucent layer, no outline, soft corners. -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="18,14" />
            </Style>
            <Style x:Key="RegionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="140" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <Style x:Key="Secondary" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Mono" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <!-- Pills instead of boxed chips. -->
            <Style x:Key="Chip" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="999" />
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ChipText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="SmallButton" TargetType="Button">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="MinHeight" Value="0" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" Padding="18,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="RELAY" FontWeight="SemiBold" FontSize="12" CharacterSpacing="220" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleSubtitle" Grid.Column="1" Style="{StaticResource Mono}" VerticalAlignment="Center" Text="local-first orchestrator" />
        </Grid>

        <!-- Startup failure (replaces everything when the runtime could not be created) -->
        <Border x:Name="StartupFailurePanel" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource Card}" Margin="16" VerticalAlignment="Top">
            <StackPanel Spacing="8">
                <TextBlock Text="RELAY COULD NOT START" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                <TextBlock x:Name="StartupFailureText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                <TextBlock x:Name="StartupFailureHint" Style="{StaticResource Secondary}" />
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,0,18,18">
            <StackPanel Spacing="10">

                <!-- 1. STATUS: state, the chords, the engines, and the process tags of everything running -->
                <Border Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse x:Name="StateDot" Width="10" Height="10" VerticalAlignment="Center" Fill="Gray" />
                                <TextBlock x:Name="StateLabel" Text="STARTING" FontSize="24" FontWeight="SemiBold" CharacterSpacing="40" VerticalAlignment="Center" />
                                <TextBlock x:Name="ModeLabel" Style="{StaticResource Secondary}" VerticalAlignment="Center" FontSize="13" Margin="2,3,0,0" />
                            </StackPanel>
                            <Button x:Name="SettingsButton" Grid.Column="1" Style="{StaticResource SmallButton}" Content="Settings" Click="Settings_Click" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="StateDetail" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <local:WrapPanel HorizontalSpacing="6" VerticalSpacing="6">
                            <Border Style="{StaticResource Chip}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse x:Name="NoteKeyDot" Width="6" Height="6" Fill="Gray" VerticalAlignment="Center" />
                                    <TextBlock x:Name="NoteKeyChip" Style="{StaticResource ChipText}" Text="LISTEN" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Chip}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse x:Name="CommandKeyDot" Width="6" Height="6" Fill="Gray" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CommandKeyChip" Style="{StaticResource ChipText}" Text="ASK" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Chip}">
                                <TextBlock x:Name="ScopeChip" Style="{StaticResource ChipText}" Text="this window only" />
                            </Border>
                            <Border Style="{StaticResource Chip}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse x:Name="OrchestratorDot" Width="6" Height="6" Fill="Gray" VerticalAlignment="Center" />
                                    <TextBlock x:Name="OrchestratorChip" Style="{StaticResource ChipText}" Text="Planner" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Chip}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse x:Name="JudgeDot" Width="6" Height="6" Fill="Gray" VerticalAlignment="Center" />
                                    <TextBlock x:Name="JudgeChip" Style="{StaticResource ChipText}" Text="Judge" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Chip}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse x:Name="LedgerDot" Width="6" Height="6" Fill="Gray" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LedgerChip" Style="{StaticResource ChipText}" Text="Ledger" />
                                </StackPanel>
                            </Border>
                        </local:WrapPanel>
                        <!-- Process tags: one per lane that is active right now; each names the only permissions that lane may use. -->
                        <StackPanel x:Name="ProcessPanel" Spacing="6" Visibility="Collapsed">
                            <TextBlock Text="PROCESS" Style="{StaticResource RegionHeader}" />
                            <local:WrapPanel x:Name="ProcessTags" HorizontalSpacing="6" VerticalSpacing="6" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. CAPTURE / LISTENING -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock x:Name="CaptureHeader" Text="CAPTURE" Style="{StaticResource RegionHeader}" VerticalAlignment="Center" />
                            <TextBlock x:Name="CaptureMeta" Style="{StaticResource Mono}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="ReadyGreeting" Text="Ready" FontSize="20" FontWeight="SemiBold" Visibility="Collapsed" />
                        <InfoBar x:Name="FocusBar" Severity="Warning" IsOpen="False" IsClosable="False"
                                 Title="Capture surface lost focus"
                                 Message="Text inserted by Flow will go to whichever window is focused, not to Relay.">
                            <InfoBar.ActionButton>
                                <Button Content="Refocus" Click="Refocus_Click" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <!-- The rolling buffer while listening: how much of the window is held, what the judge has done, never the words. -->
                        <StackPanel x:Name="ListeningPanel" Spacing="6" Visibility="Collapsed">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="BufferBar" Minimum="0" Maximum="90" Value="0" VerticalAlignment="Center" />
                                <TextBlock x:Name="BufferText" Grid.Column="1" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="ListeningText" Style="{StaticResource Secondary}" />
                            <TextBlock x:Name="ListeningError" Style="{StaticResource Secondary}" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
                        </StackPanel>
                        <TextBox x:Name="CaptureBox"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" MaxHeight="300"
                                 FontSize="15" IsReadOnly="True" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                                 BorderThickness="0" CornerRadius="8" Padding="14,10"
                                 Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 PlaceholderText="Press Ctrl+Alt to listen or Ctrl+X to give an instruction."
                                 TextChanged="CaptureBox_TextChanged" GotFocus="CaptureBox_GotFocus" LostFocus="CaptureBox_LostFocus" KeyDown="CaptureBox_KeyDown" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CancelButton" Content="Cancel  (Esc)" Click="Cancel_Click" Visibility="Collapsed" />
                            <Button x:Name="SubmitNowButton" Content="Submit now" Click="SubmitNow_Click" Visibility="Collapsed" Style="{ThemeResource AccentButtonStyle}" />
                            <Button x:Name="RetryWaitButton" Content="Retry wait" Click="RetryWait_Click" Visibility="Collapsed" />
                            <Button x:Name="DismissButton" Content="Return to Idle" Click="Dismiss_Click" Visibility="Collapsed" />
                            <Button x:Name="RetryButton" Content="Retry" Click="Retry_Click" Visibility="Collapsed" Style="{ThemeResource AccentButtonStyle}" />
                            <Button x:Name="UnlockButton" Content="Unlock" Click="Unlock_Click" Visibility="Collapsed" Style="{ThemeResource AccentButtonStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
                        <!-- The ask box: a direct question at any settled moment, including while listening. -->
                        <Grid x:Name="AskPanel" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AskBox" AutomationProperties.Name="Ask box" PlaceholderText="Ask Relay… (Enter)" FontSize="13" IsSpellCheckEnabled="False"
                                     BorderThickness="0" CornerRadius="8" Padding="12,8"
                                     Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                     KeyDown="AskBox_KeyDown" />
                            <Button x:Name="AskButton" Grid.Column="1" Content="Ask" Click="Ask_Click" VerticalAlignment="Center" Style="{ThemeResource AccentButtonStyle}" />
                        </Grid>
                        <TextBlock x:Name="AskHint" Style="{StaticResource Secondary}" FontSize="11" Text="A direct question is answered in Response; while listening it runs beside the stream and its answer arrives as a card." />
                    </StackPanel>
                </Border>

                <!-- 3. RESPONSE: what the planner did with the foreground instruction -->
                <Border x:Name="ResponseCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="RESPONSE" Style="{StaticResource RegionHeader}" />
                            <TextBlock x:Name="ResponseMeta" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                        </Grid>
                        <local:WrapPanel x:Name="ResponseTags" HorizontalSpacing="6" VerticalSpacing="6" />
                        <TextBlock x:Name="ResponseInstruction" Style="{StaticResource Secondary}" FontStyle="Italic" />
                        <TextBlock x:Name="ResponseSummary" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <StackPanel x:Name="ResponseSteps" Spacing="2" />
                        <Border x:Name="ResponseAnswerBorder" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10" Visibility="Collapsed">
                            <TextBlock x:Name="ResponseAnswer" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="13" LineHeight="20" />
                        </Border>
                        <TextBlock x:Name="ResponseKnowledge" Style="{StaticResource Secondary}" Visibility="Collapsed" IsTextSelectionEnabled="True" />
                        <StackPanel x:Name="ResponseCitations" Spacing="4" />
                        <StackPanel x:Name="ResponseProposals" Spacing="8" />
                        <StackPanel x:Name="ResponseButtons" Orientation="Horizontal" Spacing="8" />
                    </StackPanel>
                </Border>

                <!-- 4. ATTENTION: what RELAY0 decided you should see, at the level the arbiter chose -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="ATTENTION" Style="{StaticResource RegionHeader}" />
                            <TextBlock x:Name="AttentionCount" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock x:Name="AttentionEmpty" Style="{StaticResource Secondary}" Text="Nothing needs your attention. Observed findings appear here as results, alerts, or proposals; direct asks while listening answer here." />
                        <StackPanel x:Name="AttentionItems" Spacing="8" />
                        <StackPanel x:Name="AmbientItems" Spacing="2" />
                    </StackPanel>
                </Border>

                <!-- 5. REVIEW -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="REVIEW" Style="{StaticResource RegionHeader}" />
                            <TextBlock x:Name="ReviewCount" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock x:Name="ReviewEmpty" Style="{StaticResource Secondary}" Text="Nothing awaiting your decision." />
                        <StackPanel x:Name="ReviewItems" Spacing="8" />
                    </StackPanel>
                </Border>

                <!-- 6. INBOX: unrouted notes, each with the router's candidates when it asked -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="INBOX" Style="{StaticResource RegionHeader}" />
                            <TextBlock x:Name="InboxCount" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock x:Name="InboxEmpty" Style="{StaticResource Secondary}" Text="No unrouted notes. Notes that mention a project are filed there automatically; the rest wait here." />
                        <StackPanel x:Name="InboxItems" Spacing="8" />
                    </StackPanel>
                </Border>

                <!-- 7. TASKS: every task of this session with its process tag, producer, presentation and cost -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="TASKS" Style="{StaticResource RegionHeader}" />
                            <TextBlock x:Name="TasksCount" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock x:Name="TasksEmpty" Style="{StaticResource Secondary}" Text="No tasks yet. Direct asks, observed findings and follow-ups all appear here with the lane they run in." />
                        <StackPanel x:Name="TaskItems" Spacing="6" />
                    </StackPanel>
                </Border>

                <!-- 8. PROJECTS -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="PROJECTS" Style="{StaticResource RegionHeader}" />
                            <TextBlock x:Name="ProjectsCount" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock x:Name="ProjectsEmpty" Style="{StaticResource Secondary}" Text="No projects yet. Use New project… to pick the folder projects live in; after that “create project &lt;name&gt;” works by voice too." />
                        <StackPanel x:Name="ProjectItems" Spacing="6" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="NewProjectButton" Style="{StaticResource SmallButton}" Content="New project…" Click="NewProject_Click" />
                            <Button x:Name="BackupButton" Style="{StaticResource SmallButton}" Content="Export backup" Click="Backup_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 9. RELAY: the typed preferences as compiled, standing grants, and every self-change with its revert -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="RELAY" Style="{StaticResource RegionHeader}" />
                            <TextBlock x:Name="RelayMeta" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock x:Name="PreferencesText" Style="{StaticResource Secondary}" IsTextSelectionEnabled="True" />
                        <StackPanel x:Name="PinnedPanel" Spacing="6" Visibility="Collapsed">
                            <TextBlock Text="ALWAYS SHOWN" Style="{StaticResource RegionHeader}" />
                            <local:WrapPanel x:Name="PinnedTerms" HorizontalSpacing="6" VerticalSpacing="6" />
                        </StackPanel>
                        <StackPanel x:Name="GrantsPanel" Spacing="6" Visibility="Collapsed">
                            <TextBlock Text="STANDING GRANTS" Style="{StaticResource RegionHeader}" />
                            <StackPanel x:Name="GrantItems" Spacing="4" />
                        </StackPanel>
                        <StackPanel x:Name="ChangeSetsPanel" Spacing="6" Visibility="Collapsed">
                            <TextBlock Text="CHANGE SETS" Style="{StaticResource RegionHeader}" />
                            <StackPanel x:Name="ChangeSetItems" Spacing="4" />
                        </StackPanel>
                        <TextBlock x:Name="RelayHint" Style="{StaticResource Secondary}" FontSize="11" Text="Shape Relay by asking: “keep responses concise”, “always show what CAD means”, “file Atlas decisions without asking”. Each is a change set you approve and can revert here." />
                    </StackPanel>
                </Border>

                <!-- 10. ACTIVITY -->
                <Border Style="{StaticResource Card}" Padding="18,14,18,8">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="ACTIVITY" Style="{StaticResource RegionHeader}" />
                            <TextBlock x:Name="ActivityCount" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                        </Grid>
                        <ListView x:Name="ActivityList" Height="200" SelectionMode="None" IsItemClickEnabled="False"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="0" Margin="-12,0"
                                  Loaded="ActivityList_Loaded">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="12,3" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:ActivityRow">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Time}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Text}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Type}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- DIAGNOSTICS: the drawer for one task (prompt, tools, model calls, decisions, presentation, your response) and the system rows -->
                <Expander x:Name="DiagnosticsExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Expanding="Diagnostics_Expanding">
                    <Expander.Header>
                        <Grid>
                            <TextBlock Text="DIAGNOSTICS" Style="{StaticResource RegionHeader}" VerticalAlignment="Center" />
                            <TextBlock x:Name="DiagnosticsMeta" Style="{StaticResource Mono}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="12">
                        <StackPanel x:Name="TaskDiagnosticsPanel" Spacing="8" Visibility="Collapsed">
                            <Grid>
                                <TextBlock x:Name="TaskDiagnosticsTitle" Text="TASK" Style="{StaticResource RegionHeader}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                    <Button x:Name="OpenTaskFileButton" Style="{StaticResource SmallButton}" Content="Open record" Click="OpenTaskFile_Click" />
                                    <Button Style="{StaticResource SmallButton}" Content="Close" Click="CloseTaskDiagnostics_Click" />
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="TaskDiagnosticsGrid" ColumnSpacing="16" RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </StackPanel>
                        <TextBlock Text="SYSTEM" Style="{StaticResource RegionHeader}" />
                        <Grid x:Name="DiagnosticsGrid" ColumnSpacing="16" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
