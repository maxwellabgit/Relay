<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Relay.Worker</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The worker has no reference to Relay.Core, never opens a file itself, and talks to Relay only
         through JSON lines on stdin/stdout. Everything it reads or writes goes through the broker, which
         enforces the run's allowlists. Its one dependency is Jint, the managed JavaScript interpreter
         that runs the tools Relay builds for itself (docs/09, slice 6): pure computation with the
         broker's host functions as the only way out. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.16.1" />
  </ItemGroup>

</Project>
